{
  "name": "pi-pulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"node server.js\"",
    "build": "npm run test:trust && vite build",
    "preview": "vite preview",
    "preview:lab": "node scripts/preview-lab.mjs",
    "start": "node server.js",
    "test:trust": "node scripts/trust-fixtures.mjs && node scripts/trust-ui.mjs && node scripts/trust-smoke.mjs && npm run test:verification",
    "test:verification": "node --test scripts/trust-verification.mjs"
  },
  "dependencies": {
    "express": "^4.18.2",
    "framer-motion": "^11.0.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "esbuild": "^0.21.5",
    "playwright": "^1.62.1",
    "playwright-core": "^1.62.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.4"
  }
}
