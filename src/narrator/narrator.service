[Unit]
Description=Narrator — the Pi speaks about itself
After=network.target hailo-ollama.service
Wants=hailo-ollama.service

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/lab/src/narrator
ExecStart=/usr/bin/node narrator.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=narrator

[Install]
WantedBy=multi-user.target
