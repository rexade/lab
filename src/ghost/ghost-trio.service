[Unit]
Description=ghost-trio — invisible machine observation quartet
After=network.target hailo-ollama.service
Wants=hailo-ollama.service

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/lab/src/ghost
ExecStart=/bin/bash /home/admin/lab/src/ghost/start.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ghost-trio
KillMode=process

[Install]
WantedBy=multi-user.target
